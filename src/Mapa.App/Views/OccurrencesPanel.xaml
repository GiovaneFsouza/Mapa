<UserControl x:Class="Mapa.App.Views.OccurrencesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:vm="clr-namespace:Mapa.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OccurrencesViewModel}">
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Detected events, grouped by grandeza -->
        <Border Grid.Column="0" BorderBrush="#DDDDDD" BorderThickness="1" Margin="0,0,4,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="10,8">
                    <TextBlock Text="Detalhamento dos Eventos" FontWeight="Bold" FontSize="16" />
                    <TextBlock Text="Detecções próximas no tempo são agrupadas como um mesmo evento."
                               FontSize="10" Foreground="#888888" TextWrapping="Wrap" Margin="0,2,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="#F7F7F7" BorderBrush="#EEEEEE" BorderThickness="0,1,0,1" Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="VTCD" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Gap máx. (ms):" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"
                                       ToolTip="Intervalo máximo entre dois eventos consecutivos para entrarem no mesmo grupo." />
                            <TextBox Width="52" FontSize="11" VerticalContentAlignment="Center"
                                     Text="{Binding VtcdGapMaxMs, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Range máx. (ms):" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"
                                       ToolTip="Intervalo máximo entre o primeiro e o último evento do grupo." />
                            <TextBox Width="52" FontSize="11" VerticalContentAlignment="Center"
                                     Text="{Binding VtcdRangeMaxMs, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <TextBlock Text="Frequência" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="Janela (ms):" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"
                                       ToolTip="Intervalo máximo entre detecções de PMUs para considerá-las parte do mesmo evento." />
                            <TextBox Width="52" FontSize="11" VerticalContentAlignment="Center"
                                     Text="{Binding FreqWindowMs, StringFormat=0.##, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Mín. PMUs:" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0"
                                       ToolTip="Número mínimo de PMUs distintas para listar o evento." />
                            <TextBox Width="52" FontSize="11" VerticalContentAlignment="Center"
                                     Text="{Binding FreqMinPmus, UpdateSourceTrigger=LostFocus}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Text="Ordenar:" VerticalAlignment="Center" FontSize="11" Margin="0,0,6,0" />
                            <ComboBox Width="150" FontSize="11" VerticalContentAlignment="Center"
                                      SelectedValue="{Binding SortOption}" SelectedValuePath="Tag">
                                <ComboBoxItem Content="Mais recentes" Tag="{x:Static vm:OccurrenceSortOption.MostRecent}" />
                                <ComboBoxItem Content="Mais PMUs" Tag="{x:Static vm:OccurrenceSortOption.MostPmus}" />
                                <ComboBoxItem Content="Mais severos" Tag="{x:Static vm:OccurrenceSortOption.MostSevere}" />
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="#666666"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="2" x:Name="OccurrenceList"
                         ItemsSource="{Binding OccurrencesView}" SelectedItem="{Binding SelectedOccurrence}"
                         BorderThickness="0" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <Border Background="#EFEFEF" Padding="8,4" Margin="0,4,0,2">
                                        <TextBlock FontWeight="Bold" FontSize="11" Foreground="#444444">
                                            <Run Text="{Binding Name, Mode=OneWay}" />
                                            <Run Text=" (" /><Run Text="{Binding ItemCount, Mode=OneWay}" /><Run Text=")" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:OccurrenceItemViewModel}">
                            <Grid Margin="2,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding DateLabel}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding TimeLabel}" FontSize="11" Foreground="#666666" />
                                </StackPanel>
                                <Border Grid.Column="1" Background="#E8F0F8" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PmuCountLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#2166AC" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Map + severity-ranked detail for the selected event -->
        <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="100" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="200" MinHeight="80" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PMUs atingidas por este evento" FontWeight="Bold" FontSize="13" />
                        <TextBlock Text="{Binding SelectedSummary}" FontSize="11" Foreground="#666666"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">

                        <!-- Legenda VTCD subtensão -->
                        <Border Margin="0,0,14,0"
                                Visibility="{Binding HasVtcdSubLegend, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Limites" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#666666" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Rectangle Width="10" Height="10" Fill="#2ECC71" RadiusX="2" RadiusY="2"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding VtcdSubLegendHigh}" FontSize="10"
                                               Foreground="#444444" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Rectangle Width="10" Height="10" Fill="#F39C12" RadiusX="2" RadiusY="2"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding VtcdSubLegendMid}" FontSize="10"
                                               Foreground="#444444" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Rectangle Width="10" Height="10" Fill="#E74C3C" RadiusX="2" RadiusY="2"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding VtcdSubLegendLow}" FontSize="10"
                                               Foreground="#444444" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Legenda VTCD sobretensão -->
                        <Border Margin="0,0,14,0"
                                Visibility="{Binding HasVtcdSobreLegend, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Limites" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#666666" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Rectangle Width="10" Height="10" Fill="#2ECC71" RadiusX="2" RadiusY="2"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding VtcdSobreLegendNormal}" FontSize="10"
                                               Foreground="#444444" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Rectangle Width="10" Height="10" Fill="#F39C12" RadiusX="2" RadiusY="2"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding VtcdSobreLegendMid}" FontSize="10"
                                               Foreground="#444444" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Rectangle Width="10" Height="10" Fill="#E74C3C" RadiusX="2" RadiusY="2"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding VtcdSobreLegendHigh}" FontSize="10"
                                               Foreground="#444444" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Legenda frequência -->
                        <Border Margin="0,0,14,0"
                                Visibility="{Binding HasFreqLegend, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Tipo" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#666666" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Rectangle Width="10" Height="10" Fill="#C62828" RadiusX="2" RadiusY="2"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Sobrefrequência" FontSize="10"
                                               Foreground="#444444" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Rectangle Width="10" Height="10" Fill="#1565C0" RadiusX="2" RadiusY="2"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Subfrequência" FontSize="10"
                                               Foreground="#444444" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Legenda primeira detecção -->
                        <Border Margin="0,0,14,0"
                                Visibility="{Binding HasDetectionRankLegend, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Propagação" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#666666" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <TextBlock Text="★" FontSize="13" FontWeight="Bold" Foreground="#7C4DFF"
                                               Margin="0,0,5,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Primeira detecção" FontSize="10"
                                               Foreground="#444444" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="Exportar CSV" Command="{Binding ExportSelectedCommand}"
                                Padding="10,3" FontSize="11" VerticalAlignment="Top" />
                    </StackPanel>
                </Grid>

                <wv2:WebView2 x:Name="MapWebView" Grid.Row="1" />

                <!-- Loading overlay: visible until WebView2 finishes NavigationCompleted -->
                <Grid x:Name="MapLoadingOverlay" Grid.Row="1" Background="#F5F5F5" Panel.ZIndex="10">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="200">
                        <TextBlock x:Name="MapLoadingText" Text="Carregando mapa..." FontSize="12" Foreground="#666666"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap" />
                        <ProgressBar x:Name="MapLoadingBar" IsIndeterminate="True" Height="4" />
                    </StackPanel>
                </Grid>

                <GridSplitter Grid.Row="2" Height="5"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="#DDDDDD" Cursor="SizeNS"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" />

                <Border Grid.Row="3" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                    <DataGrid ItemsSource="{Binding SelectedOccurrenceEvents}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#EEEEEE" BorderThickness="0" FontSize="11"
                              RowHeight="22" CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="Auto" />
                            <DataGridTextColumn Header="PMU/Terminal" Binding="{Binding PmuLabel}" Width="2*" />
                            <DataGridTextColumn Header="Região" Binding="{Binding Region}" Width="Auto" />
                            <DataGridTextColumn Header="Tensão" Binding="{Binding VoltLevelLabel}" Width="Auto" />
                            <DataGridTextColumn Header="Tipo" Binding="{Binding EventType}" Width="Auto" />
                            <DataGridTextColumn Header="Grandeza" Binding="{Binding SourceLabel}" Width="Auto" />
                            <DataGridTextColumn Header="Valor" Binding="{Binding ExtremeValue}" Width="Auto" />
                            <DataGridTextColumn Header="Início" Binding="{Binding StartTime}" Width="Auto" />
                            <DataGridTextColumn Header="Δt" Binding="{Binding RelativeLabel}" Width="Auto"
                                                ToolTipService.ToolTip="Atraso em relação à primeira PMU que detectou" />
                            <DataGridTextColumn Header="Duração" Binding="{Binding DurationLabel}" Width="Auto" />
                            <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="Auto" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
