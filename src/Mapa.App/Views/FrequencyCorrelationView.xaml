<UserControl x:Class="Mapa.App.Views.FrequencyCorrelationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Mapa.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:FrequencyCorrelationViewModel}">

    <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="4">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <!-- ── Left: statistics dashboard ────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Count cards -->
                <UniformGrid Grid.Row="0" Rows="1" Margin="10,10,10,0">
                    <Border Background="#E3F2FD" CornerRadius="6" Margin="3" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalEvents}" FontSize="26" FontWeight="Bold"
                                       Foreground="#0D47A1" HorizontalAlignment="Center" />
                            <TextBlock Text="Total" FontSize="11" Foreground="#555555" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#E8EAF6" CornerRadius="6" Margin="3" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SubCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="#1A237E" HorizontalAlignment="Center" />
                            <TextBlock Text="Sub" FontSize="11" Foreground="#555555" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#FFEBEE" CornerRadius="6" Margin="3" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SobreCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="#B71C1C" HorizontalAlignment="Center" />
                            <TextBlock Text="Sobre" FontSize="11" Foreground="#555555" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#F3E5F5" CornerRadius="6" Margin="3" Padding="10,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding MistoCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="#6A1B9A" HorizontalAlignment="Center" />
                            <TextBlock Text="Misto" FontSize="11" Foreground="#555555" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Background="#ECEFF1" CornerRadius="6" Margin="3" Padding="10,8"
                            ToolTip="Eventos de frequência com início e/ou fim incerto (bit 0 ou 1 do campo quality = 1), registrados individualmente por PMU. Não entram na correlação nem nos totais ao lado.">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding UndefinedCount}" FontSize="26" FontWeight="Bold"
                                       Foreground="#455A64" HorizontalAlignment="Center" />
                            <TextBlock Text="Indefinidos" FontSize="11" Foreground="#555555" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Rankings: Mais Severos | Mais Longos -->
                <Grid Grid.Row="1" Margin="10,8,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FFF8E1" Padding="8,5" CornerRadius="4,4,0,0"
                                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                <TextBlock Text="Severo" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding BySeverity}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EEEEEE" BorderThickness="0"
                                      FontSize="11" RowHeight="22" CanUserResizeRows="False"
                                      MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data"         Binding="{Binding DateLabel}"      Width="88" />
                                    <DataGridTextColumn Header="Hora"         Binding="{Binding TimeLabel}"      Width="66" />
                                    <DataGridTextColumn Header="Tipo"         Binding="{Binding TypeLabel}"      Width="44" />
                                    <DataGridTextColumn Header="Desvio Freq"  Binding="{Binding DeviationLabel}" Width="90" />
                                    <DataGridTextColumn Header="Hz"           Binding="{Binding ExtremeHzLabel}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#E1F5FE" Padding="8,5" CornerRadius="4,4,0,0"
                                    BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
                                <TextBlock Text="Duração" FontWeight="SemiBold" FontSize="12" />
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding ByDuration}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#EEEEEE" BorderThickness="0"
                                      FontSize="11" RowHeight="22" CanUserResizeRows="False"
                                      MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data"    Binding="{Binding DateLabel}"     Width="88" />
                                    <DataGridTextColumn Header="Hora"    Binding="{Binding TimeLabel}"     Width="66" />
                                    <DataGridTextColumn Header="Tipo"    Binding="{Binding TypeLabel}"     Width="44" />
                                    <DataGridTextColumn Header="Duração" Binding="{Binding DurationLabel}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- All events (chronological) -->
                <Border Grid.Row="2" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Margin="0,8,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Todos os Eventos" FontWeight="SemiBold"
                                   FontSize="11" Margin="12,6,0,4" Foreground="#444444" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Events}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  AlternatingRowBackground="#F8F8F8"
                                  BorderThickness="0"
                                  HorizontalGridLinesBrush="#EEEEEE"
                                  FontSize="11"
                                  RowHeight="22"
                                  CanUserResizeRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data"            Binding="{Binding DateLabel}"        Width="88" />
                                <DataGridTextColumn Header="Hora"            Binding="{Binding TimeLabel}"        Width="66" />
                                <DataGridTextColumn Header="Tipo"            Binding="{Binding TypeLabel}"        Width="52" />
                                <DataGridTextColumn Header="Hz Sub (med.)"   Binding="{Binding SubHzLabel}"       Width="130" />
                                <DataGridTextColumn Header="Hz Sobre (med.)" Binding="{Binding SobreHzLabel}"     Width="130" />
                                <DataGridTextColumn Header="Dur. med."       Binding="{Binding DurationLabel}"    Width="80" />
                                <DataGridTextColumn Header="N° PMUs"         Binding="{Binding ParticipantCount}" Width="62" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Right: settings sidebar ───────────────────────────────── -->
            <Border Grid.Column="1" BorderBrush="#EEEEEE" BorderThickness="1,0,0,0" Padding="12,10,16,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="Frequência" FontWeight="Bold" FontSize="16" Margin="0,0,0,12" />

                        <TextBlock Text="{Binding StatusLabel}" TextWrapping="Wrap"
                                   FontSize="11" Foreground="#444444" Margin="0,0,0,12" />

                        <Separator Margin="0,0,0,12" />

                        <TextBlock Text="Correlação" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Janela (ms)" VerticalAlignment="Center"
                                       FontSize="11" Foreground="#555555" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding CorrelationWindowMs, StringFormat=0.##, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="SettingBox_KeyDown"
                                     BorderBrush="#B5B5B5" BorderThickness="1" Padding="4,2" />
                        </Grid>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Mín. PMUs" VerticalAlignment="Center"
                                       FontSize="11" Foreground="#555555" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding MinimumPmus, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="SettingBox_KeyDown"
                                     BorderBrush="#B5B5B5" BorderThickness="1" Padding="4,2" />
                        </Grid>


                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
