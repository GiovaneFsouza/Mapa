<UserControl x:Class="Mapa.App.Views.RankingBarsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Mapa.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:RankingViewModel}">
    <UserControl.Resources>
        <DataTemplate x:Key="RankingItemTemplate" DataType="{x:Type vm:RankingItemViewModel}">
            <Grid Margin="0,2" ToolTip="{Binding TooltipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="28" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="11"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           ToolTip="{Binding Label}" />

                <Grid Grid.Column="1" Height="14" VerticalAlignment="Center" Background="#F0F0F0" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionToGridLengthConverter}}" />
                        <ColumnDefinition Width="{Binding Fraction, Converter={StaticResource FractionToGridLengthConverter}, ConverterParameter=Invert}" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{Binding ColorHex, Converter={StaticResource HexColorToBrushConverter}}" CornerRadius="2" />
                </Grid>

                <TextBlock Grid.Column="2" Text="{Binding ValueDisplay}" FontSize="11"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel MaxWidth="400" HorizontalAlignment="Stretch">
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding PrimaryTitle}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" />
            <TextBlock Grid.Column="1" Text="{Binding ValueHeader}" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Primary}" ItemTemplate="{StaticResource RankingItemTemplate}" />
        <TextBlock Text="nenhum evento no período" FontSize="10" Foreground="#AAAAAA" FontStyle="Italic"
                   Visibility="{Binding Primary.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />

        <!-- Second block exists only in Severidade, one list per direction -->
        <StackPanel Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding SecondaryTitle}" FontWeight="SemiBold" FontSize="12" Margin="0,12,0,4" />
            <ItemsControl ItemsSource="{Binding Secondary}" ItemTemplate="{StaticResource RankingItemTemplate}" />
            <TextBlock Text="nenhum evento no período" FontSize="10" Foreground="#AAAAAA" FontStyle="Italic"
                       Visibility="{Binding Secondary.Count, Converter={StaticResource ZeroToVisibilityConverter}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
