<UserControl x:Class="Mapa.App.Views.GrandezaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:vm="clr-namespace:Mapa.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:GrandezaPanelViewModel}">
    <UserControl.Resources>

        <!-- Direction toggle button style (RadioButton looks like a segmented button) -->
        <Style x:Key="DirectionToggleStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#CCCCCC" BorderThickness="1"
                                CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E3F2FD" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#1976D2" />
                                <Setter Property="Foreground" Value="#1565C0" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F0F0F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScaleInputStyle" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#B5B5B5" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="#555555" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border BorderBrush="#DDDDDD" BorderThickness="1" Margin="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="430" MinWidth="260" MaxWidth="900" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{Binding Title}"
                       FontWeight="Bold" FontSize="16" Margin="8,6" />

            <wv2:WebView2 x:Name="MapWebView" Grid.Row="1" Grid.Column="0" />

            <GridSplitter Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#EEEEEE" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                    BorderBrush="#EEEEEE" BorderThickness="1,0,0,0" Padding="14,10,14,10">
                <ScrollViewer VerticalScrollBarVisibility="Visible">
                    <StackPanel>

                        <!-- Direction selector (Severity / Duration only) -->
                        <Grid Margin="0,0,0,8">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDirectionalThresholds}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RadioButton Grid.Column="0"
                                         Content="{Binding SubLabel}"
                                         IsChecked="{Binding IsSubSelected}"
                                         Style="{StaticResource DirectionToggleStyle}" />
                            <RadioButton Grid.Column="2"
                                         Content="{Binding SobreLabel}"
                                         IsChecked="{Binding IsSobreSelected}"
                                         Style="{StaticResource DirectionToggleStyle}" />
                        </Grid>

                        <TextBlock Text="Limites" FontWeight="SemiBold" Margin="0,0,0,6" />

                        <!-- Three-zone color legend with value ranges -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="16" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="16" />
                                <RowDefinition Height="3" />
                                <RowDefinition Height="16" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="#2ECC71" CornerRadius="3" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       Text="{Binding ColorBarGreenLabel}"
                                       FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />

                            <Border Grid.Row="2" Grid.Column="0" Background="#F39C12" CornerRadius="3" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       Text="{Binding ColorBarYellowLabel}"
                                       FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />

                            <Border Grid.Row="4" Grid.Column="0" Background="#E74C3C" CornerRadius="3" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       Text="{Binding ColorBarRedLabel}"
                                       FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </Grid>

                        <!-- Inferior / Superior inputs -->
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Inferior" Style="{StaticResource LabelStyle}" Margin="0,0,4,0" />
                            <TextBox   Grid.Column="1" Style="{StaticResource ScaleInputStyle}"
                                       Text="{Binding ThresholdL1}"
                                       KeyDown="ThresholdBox_KeyDown"
                                       HorizontalContentAlignment="Center" Width="64" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="2" Text="Superior" Style="{StaticResource LabelStyle}" Margin="0,0,4,0" />
                            <TextBox   Grid.Column="3" Style="{StaticResource ScaleInputStyle}"
                                       Text="{Binding ThresholdL2}"
                                       KeyDown="ThresholdBox_KeyDown"
                                       HorizontalContentAlignment="Center" Width="64" />
                        </Grid>

                        <Border Background="#E8F4FD" BorderBrush="#90CAF9" BorderThickness="1" Margin="0,8,0,0" Padding="6"
                                Visibility="{Binding HasDetectionBandNote, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding DetectionBandNote}" TextWrapping="Wrap" FontSize="11" Foreground="#1565C0" />
                        </Border>

                        <Border Background="#FFF3CD" BorderBrush="#FFE69C" BorderThickness="1" Margin="0,8,0,0" Padding="6"
                                Visibility="{Binding HasUnmatchedIdNameWarning, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding UnmatchedIdNameSummary}" TextWrapping="Wrap" FontSize="11" />
                        </Border>

                        <ContentControl Content="{Binding Ranking}" Margin="0,14,0,0" />
                        <ContentControl Content="{Binding RegionalQuantity}" Margin="0,14,0,0"
                                        Visibility="{Binding Mode, Converter={StaticResource EnumEqualsVisibilityConverter}, ConverterParameter=Quantity}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
