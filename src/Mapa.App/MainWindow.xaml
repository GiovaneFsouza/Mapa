<Window x:Class="Mapa.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Mapa.App.ViewModels"
        xmlns:views="clr-namespace:Mapa.App.Views"
        mc:Ignorable="d"
        Title="MPleno GeoEventos" Height="820" Width="1400"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Filter bar -->
        <DockPanel Grid.Row="0" Margin="10,8" LastChildFill="False">

            <!-- Fonte de Dados: anchored to the right -->
            <GroupBox DockPanel.Dock="Right" Header="Fonte de Dados" Margin="10,0,0,4" Padding="6">
                <StackPanel Orientation="Vertical" Width="420">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Histórico:" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding BdedFolderPath, Mode=OneWay}" IsReadOnly="True"
                                 Width="298" VerticalContentAlignment="Center" FontSize="11"
                                 ToolTip="{Binding BdedFolderPath}"/>
                        <Button Content="…" Command="{Binding BrowseBdedFolderCommand}"
                                Margin="4,0,0,0" Padding="6,2" ToolTip="Selecionar pasta do histórico de eventos"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Configuração:" Width="80" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding ConfigJsonPath, Mode=OneWay}" IsReadOnly="True"
                                 Width="298" VerticalContentAlignment="Center" FontSize="11"
                                 ToolTip="{Binding ConfigJsonPath}"/>
                        <Button Content="…" Command="{Binding BrowseConfigJsonCommand}"
                                Margin="4,0,0,0" Padding="6,2" ToolTip="Selecionar arquivo config.json"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Filters: left side -->
            <StackPanel Orientation="Horizontal">
                <GroupBox Header="Período" Margin="0,0,10,4" Padding="6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <DatePicker SelectedDate="{Binding Filter.StartDate}" Width="120" Height="26" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Filter.StartTimeText, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" Margin="4,0,10,0" VerticalContentAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Text="até" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <DatePicker SelectedDate="{Binding Filter.EndDate}" Width="120" Height="26" VerticalAlignment="Center" />
                        <TextBox Text="{Binding Filter.EndTimeText, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="26" Margin="4,0,0,0" VerticalContentAlignment="Center" VerticalAlignment="Center" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Modo" Margin="0,0,10,4" Padding="6"
                          Visibility="{Binding IsVoltageMapTabActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Mode" Content="Quantidade" Margin="0,0,10,0" VerticalAlignment="Center"
                                     IsChecked="{Binding Filter.ActiveMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Quantity}" />
                        <RadioButton GroupName="Mode" Content="Severidade" Margin="0,0,10,0" VerticalAlignment="Center"
                                     IsChecked="{Binding Filter.ActiveMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Severity}" />
                        <RadioButton GroupName="Mode" Content="Duração" Margin="0,0,10,0" VerticalAlignment="Center"
                                     IsChecked="{Binding Filter.ActiveMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Duration}" />
                        <RadioButton GroupName="Mode" Content="Indefinidos" VerticalAlignment="Center"
                                     IsChecked="{Binding Filter.ActiveMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Undefined}"
                                     ToolTip="Eventos VTCD cujo início e/ou fim é incerto (bits 0 ou 1 do campo quality = 1). O detector classifica esses eventos como UNDEFINED em vez de IMT/AMT/EMT/etc." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Integridade dos Dados" Margin="0,0,10,4" Padding="6">
                    <CheckBox Content="Somente séries íntegras" VerticalAlignment="Center"
                              IsChecked="{Binding Filter.OnlyQualityOk}"
                              IsEnabled="{Binding Filter.IsQualityFilterApplicable}"
                              ToolTip="Considera apenas eventos com série temporal completa e confiável: início e fim bem determinados, sem frames inválidos, sem perda de frames e sem timeout. Não se aplica ao modo Indefinidos." />
                </GroupBox>

                <GroupBox Header="Região" Margin="0,0,10,4" Padding="6">
                    <ComboBox ItemsSource="{Binding Filter.Regions}" SelectedItem="{Binding Filter.SelectedRegion}"
                              Width="70" VerticalContentAlignment="Center" />
                </GroupBox>
            </StackPanel>

        </DockPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" Margin="14,0,10,8" FontSize="12" Foreground="#555555" />

        <!-- Two workspaces: per-PMU analysis (Mapa) vs per-disturbance analysis (Ocorrências) -->
        <TabControl Grid.Row="2" Margin="6,0,6,6" SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Eventos Detectados">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tensão / Frequência type selector -->
                    <Border Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="GrandezaType" Content="VTCD"
                                         IsChecked="{Binding IsShowingVoltage}"
                                         VerticalAlignment="Center" Margin="0,0,16,0" />
                            <RadioButton GroupName="GrandezaType" Content="Desvio de Frequência"
                                         IsChecked="{Binding IsShowingFrequency}"
                                         VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Voltage view -->
                    <views:GrandezaPanel x:Name="VoltagePanelView" Grid.Row="1"
                                         DataContext="{Binding VoltagePanel}"
                                         Visibility="{Binding DataContext.IsShowingVoltage,
                                                      RelativeSource={RelativeSource AncestorType=Window},
                                                      Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Frequency correlation view -->
                    <views:FrequencyCorrelationView x:Name="FreqCorrelationView" Grid.Row="1"
                                                    DataContext="{Binding FrequencyCorrelation}"
                                                    Visibility="{Binding DataContext.IsShowingFrequency,
                                                                 RelativeSource={RelativeSource AncestorType=Window},
                                                                 Converter={StaticResource BoolToVisibilityConverter}}" />
                </Grid>
            </TabItem>

            <TabItem Header="Detalhamento dos Eventos">
                <views:OccurrencesPanel x:Name="OccurrencesPanelView" DataContext="{Binding Occurrences}" />
            </TabItem>
        </TabControl>

        <!-- Busy overlay while event-history folder is being scanned -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#AA000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="6" />
                <TextBlock Text="Carregando dados..." Foreground="White" FontSize="14" Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
